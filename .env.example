# All variables are optional. Copy to .env.local and fill in the ones you have.
# Anything left empty is simply omitted from the site (no placeholder text is shown).

# Email + phone rendered as contact buttons in the footer.
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""

# Social profiles shown in the footer when set.
VITE_INSTAGRAM_URL=""
VITE_PINTEREST_URL=""
VITE_FACEBOOK_URL=""

# Production origin, e.g. https://krishnajewelry.com
# When set, the build adds canonical/og:url tags plus sitemap.xml and a
# robots.txt Sitemap line. Left empty, the build stays domain-agnostic.
VITE_SITE_URL=""
